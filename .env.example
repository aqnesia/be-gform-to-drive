PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cv_generator?sslmode=disable
WEBHOOK_SECRET=your-secret-token-here

# LLM Configuration (Bisa Gemini, OpenAI, atau 9router)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.9router.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-api-key-here

# Google Drive Apps Script
DRIVE_SCRIPT_URL=https://script.google.com/macros/s/xxx/exec
DRIVE_SCRIPT_SECRET=your-drive-script-secret-here

# GoWA WhatsApp Notification
GOWA_URL=http://gowa-service:3000
GOWA_AUTH=your-gowa-auth-token-here
ADMIN_WA_NUMBER=6281234567890

# Files
TEMPLATE_PATH=./templates/output-template-cv.xlsx
TMP_DIR=./tmp

